<view class="container">
  <view class="patient-info">
    <text class="label">患者：{{patientName}}</text>
    <text class="label">诊断：{{diagnosis}}</text>
    <text class="label">术后天数：{{postOpDays}} 天</text>
    <button size="mini" type="default" bindtap="editInfo">修改信息</button>
  </view>

  <view class="task-list" wx:if="{{tasks.length > 0}}">
    <view class="task-title">今日康复任务</view>
    <block wx:for="{{tasks}}" wx:key="index">
      <view class="task-item {{item.completed ? 'completed' : ''}}">
        <view class="task-content">
          <text class="task-name">{{item.name}}</text>
          <text class="task-instruction">{{item.instruction}}</text>
        </view>
        <view class="task-action">
          <button wx:if="{{!item.completed}}" bindtap="completeTask" data-index="{{index}}" size="mini" type="primary">完成</button>
          <text wx:else class="done-label">✅ 已完成</text>
        </view>
      </view>
    </block>
  </view>

  <view class="nav-links" wx:if="{{tasks.length > 0}}">
    <button bindtap="goToHistory" type="default">查看历史打卡记录</button>
    <button bindtap="goToRecords" type="default">📊 康复数据</button>
  </view>

  <view class="empty-tip" wx:if="{{!loading && tasks.length === 0}}">
    <text>暂无康复计划，请点击“修改信息”重新生成</text>
  </view>
  <view class="loading-tip" wx:if="{{loading}}">
    <text>AI正在生成康复计划...</text>
  </view>
</view>