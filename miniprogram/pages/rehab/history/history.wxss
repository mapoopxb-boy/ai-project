.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.empty-tip {
  text-align: center;
  padding: 100rpx;
  color: #999;
}
.header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.canvas {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.legend {
  text-align: center;
  color: #666;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}
.record-list {
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
}
.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.date {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}
.rate {
  width: 160rpx;
  font-size: 26rpx;
  color: #07c160;
}
progress {
  flex: 1;
}