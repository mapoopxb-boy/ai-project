<view class="container">
  <view wx:if="{{historyData.length === 0}}" class="empty-tip">暂无历史打卡数据</view>
  <view wx:else>
    <view class="header">康复完成率趋势</view>
    <canvas canvas-id="historyCanvas" class="canvas" style="width:100%; height:400rpx;"></canvas>
    <view class="legend">最近7天完成率折线图</view>
    <view class="record-list">
      <view wx:for="{{historyData}}" wx:key="index" class="record-item">
        <text class="date">{{item.date}}</text>
        <text class="rate">完成率：{{item.rate}}%</text>
        <progress percent="{{item.rate}}" stroke-width="4" activeColor="#07c160" backgroundColor="#f0f0f0" />
      </view>
    </view>
  </view>
</view>