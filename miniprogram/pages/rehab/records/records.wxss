.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 概览卡片 */
.summary-card {
  display: flex;
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 30rpx;
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}
.summary-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 记录列表 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}
.record-list {
  margin-bottom: 30rpx;
}
.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.record-date {
  font-size: 26rpx;
  color: #999;
}
.record-delete {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 4rpx 12rpx;
}
.record-body {}
.record-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.record-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}
.record-value-row {
  display: flex;
  align-items: center;
  flex: 1;
}
.record-value {
  font-size: 30rpx;
  font-weight: bold;
}
.pain-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}
.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #e8e8e8;
  border-radius: 7rpx;
  margin-right: 16rpx;
}
.progress-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}
.record-note {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0f0f0;
}
.note-text {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}
.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  display: block;
}

/* 加载中 */
.loading-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 提交按钮 */
.submit-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background: linear-gradient(transparent, #f5f5f5 30%);
}
.submit-btn-wrapper button {
  background: #07c160;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 提交表单 */
.form-panel {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.form-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
  text-align: center;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.form-value {
  font-weight: bold;
  color: #07c160;
}
.slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.form-item textarea {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}
.form-actions button {
  margin: 0;
}
