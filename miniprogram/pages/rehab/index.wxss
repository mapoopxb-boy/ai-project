.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.patient-info {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  color: #333;
}
.task-list {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.task-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #07c160;
}
.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.task-item:last-child {
  border-bottom: none;
}
.task-item.completed {
  opacity: 0.6;
}
.task-content {
  flex: 1;
  padding-right: 20rpx;
}
.task-name {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.task-instruction {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}
.done-label {
  font-size: 26rpx;
  color: #07c160;
}
.nav-links {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.nav-links button {
  background: #f0f0f0;
  color: #07c160;
  margin-bottom: 30rpx;
}
.empty-tip, .loading-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
}