.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.patient-header {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.pending-banner {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff8e1;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ffe082;
}

.pending-banner:active {
  background: #fff3cd;
}

.pending-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.pending-text {
  flex: 1;
}

.pending-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e67e22;
  display: block;
}

.pending-desc {
  font-size: 24rpx;
  color: #b8860b;
  display: block;
  margin-top: 4rpx;
}

.pending-action {
  font-size: 26rpx;
  color: #e67e22;
  font-weight: 500;
  flex-shrink: 0;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}
.diagnosis {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}
.postop {
  font-size: 26rpx;
  color: #07c160;
  margin-top: 10rpx;
  display: block;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}
.chart-section, .alert-section, .message-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.trend-canvas {
  height: 300rpx;
  width: 100%;
}
.alert-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.alert-item.unresolved {
  background: #fff7e6;
}
.alert-time {
  font-size: 24rpx;
  color: #999;
}
.alert-content {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
}
.message-list {
  max-height: 400rpx;
  margin-bottom: 20rpx;
}
.message-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  max-width: 80%;
}
.doctor-msg {
  background: #e6f7ff;
  align-self: flex-start;
}
.patient-msg {
  background: #e6ffe6;
  align-self: flex-end;
  text-align: right;
}
.msg-time {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}
.input-area {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.input-area input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  padding: 20rpx;
}