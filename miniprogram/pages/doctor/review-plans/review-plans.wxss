.page-review-plans {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 30rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.page-count {
  font-size: 26rpx;
  color: #999;
}

.plan-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.patient-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.plan-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.plan-badge.pending {
  background: #fff3e0;
  color: #e67e22;
}

.plan-body {
  margin-bottom: 24rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.plan-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.plan-value {
  font-size: 28rpx;
  color: #555;
}

.plan-actions {
  display: flex;
  gap: 20rpx;
}

.btn-approve {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn-approve::after {
  border: none;
}

.btn-reject {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #e64340;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn-reject::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: none;
}

.modal-mask.show {
  display: block;
}

.modal-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  display: none;
  overflow: hidden;
}

.modal-dialog.show {
  display: block;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  padding: 30rpx 30rpx 10rpx;
}

.modal-body {
  padding: 20rpx 30rpx;
}

.modal-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.modal-textarea {
  width: 100%;
  height: 180rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: #fff;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  color: #999;
}

.modal-btn.confirm {
  color: #e64340;
  font-weight: bold;
}
