.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 时段提醒横幅 */
.time-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff9800, #f57c00);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.banner-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.banner-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
  flex: 1;
}

/* 今日概览 */
.summary-card {
  background: linear-gradient(135deg, #07c160, #059e4a);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: white;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.summary-date {
  font-size: 26rpx;
  opacity: 0.9;
}
.summary-time {
  font-size: 24rpx;
  opacity: 0.8;
}
.summary-stats {
  display: flex;
  justify-content: space-around;
}
.stat-item {
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

/* 列表标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.section-actions {
  display: flex;
  gap: 16rpx;
}
.action-btn {
  font-size: 22rpx;
  color: #07c160;
  padding: 6rpx 12rpx;
  border: 1rpx solid #07c160;
  border-radius: 20rpx;
}
.action-btn.danger {
  color: #e74c3c;
  border-color: #e74c3c;
}

/* 药品卡片 */
.med-list {
  margin-bottom: 30rpx;
}
.med-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  position: relative;
}
.med-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.med-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}
.med-dosage {
  font-size: 26rpx;
  color: #999;
}

/* 时段行 */
.med-times {
  margin-bottom: 12rpx;
}
.time-slot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #f5f5f5;
}
.time-slot:last-child {
  border-bottom: none;
}
.time-slot.taken {
  opacity: 0.6;
}
.time-label-row {
  display: flex;
  align-items: center;
}
.time-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}
.time-hour {
  font-size: 24rpx;
  color: #999;
}
.time-action {
  display: flex;
  align-items: center;
}
.take-btn {
  font-size: 24rpx;
  color: white;
  background: #07c160;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin: 0;
  min-width: 120rpx;
  text-align: center;
}
.taken-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.taken-check {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}
.taken-time {
  font-size: 22rpx;
  color: #999;
}
.unmark-btn {
  font-size: 20rpx;
  color: #e74c3c;
  padding: 4rpx 8rpx;
  border: 1rpx solid #e74c3c;
  border-radius: 12rpx;
  margin-left: 8rpx;
}

/* 备注 */
.med-note {
  font-size: 24rpx;
  color: #999;
  display: block;
  padding-top: 10rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 完成状态 */
.med-status {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}
.status-all-done {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}
.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  display: block;
}

/* 免责声明 */
.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 20rpx;
  border-top: 1rpx solid #eee;
  margin-top: 20rpx;
}
